diff --git a/pkg/pipeline/default_secrets_test.go b/pkg/pipeline/default_secrets_test.go
new file mode 100644
index 0000000..e360d8b
--- /dev/null
+++ b/pkg/pipeline/default_secrets_test.go
@@ -0,0 +1,33 @@
+package pipeline_test
+
+import (
+	"testing"
+
+	"github.com/bruin-data/bruin/pkg/pipeline"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/yaml.v3"
+)
+
+// Pipeline-level default secrets without inject_as must be injected under their own key,
+// the same way asset-level secrets are; an empty InjectedKey meant the env var was never set.
+func TestDefaultSecretsInjectUnderOwnKey(t *testing.T) {
+	t.Parallel()
+	var defaults pipeline.DefaultValues
+	require.NoError(t, yaml.Unmarshal([]byte("secrets:\n  - key: MY_API_KEY\n  - key: OTHER\n    inject_as: RENAMED\n"), &defaults))
+
+	got, err := (&pipeline.Builder{}).SetupDefaultsFromPipeline(t.Context(), &pipeline.Asset{}, &pipeline.Pipeline{DefaultValues: &defaults})
+	require.NoError(t, err)
+	require.Equal(t, []pipeline.SecretMapping{
+		{SecretKey: "MY_API_KEY", InjectedKey: "MY_API_KEY"},
+		{SecretKey: "OTHER", InjectedKey: "RENAMED"},
+	}, got.Secrets)
+
+	// an asset that already maps the same key keeps its own mapping
+	own := &pipeline.Asset{Secrets: []pipeline.SecretMapping{{SecretKey: "MY_API_KEY", InjectedKey: "ASSET_KEY"}}}
+	got, err = (&pipeline.Builder{}).SetupDefaultsFromPipeline(t.Context(), own, &pipeline.Pipeline{DefaultValues: &defaults})
+	require.NoError(t, err)
+	require.Equal(t, []pipeline.SecretMapping{
+		{SecretKey: "MY_API_KEY", InjectedKey: "ASSET_KEY"},
+		{SecretKey: "OTHER", InjectedKey: "RENAMED"},
+	}, got.Secrets)
+}
