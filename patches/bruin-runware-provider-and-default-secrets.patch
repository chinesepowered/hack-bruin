diff --git a/pkg/inference/runware_test.go b/pkg/inference/runware_test.go
new file mode 100644
index 0000000..f702130
--- /dev/null
+++ b/pkg/inference/runware_test.go
@@ -0,0 +1,51 @@
+package inference
+
+import (
+	"encoding/json"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRunwareStructuredRequest(t *testing.T) {
+	t.Parallel()
+	require.True(t, supportedProvider("runware"))
+
+	var seen *http.Request
+	var body map[string]any
+	c := Client{Provider: "runware", Model: "alibaba:qwen@4-max", APIKey: "rw-test", MaxOutputTokens: 2048,
+		HTTPClient: &http.Client{Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
+			seen = req
+			require.NoError(t, json.NewDecoder(req.Body).Decode(&body))
+			return response(http.StatusOK, `{"choices":[{"finish_reason":"stop","message":{"content":"{\"category\":\"billing\"}"}}],`+
+				`"usage":{"prompt_tokens":40,"completion_tokens":9,"prompt_tokens_details":{"cached_tokens":0}}}`), nil
+		})}}
+
+	columns := []outputColumn{{Name: "category", Type: "string", Prompt: "Classify the row."}}
+	out, err := c.CompleteStructured(t.Context(), "Ticket: refund please", "Shared rubric", columns)
+	require.NoError(t, err)
+	require.Equal(t, "billing", out["category"])
+
+	require.Equal(t, "https://api.runware.ai/v1/chat/completions", seen.URL.String())
+	require.Equal(t, "Bearer rw-test", seen.Header.Get("Authorization"))
+	require.Equal(t, "alibaba:qwen@4-max", body["model"])
+	require.EqualValues(t, 2048, body["max_tokens"])
+
+	messages := body["messages"].([]any)
+	require.Len(t, messages, 2)
+	system := messages[0].(map[string]any)
+	require.Equal(t, "system", system["role"])
+	require.Equal(t, "Shared rubric", system["content"].([]any)[0].(map[string]any)["text"])
+	require.Equal(t, map[string]any{"role": "user", "content": "Ticket: refund please"}, messages[1])
+
+	format := body["response_format"].(map[string]any)
+	require.Equal(t, "json_schema", format["type"])
+	schema := format["json_schema"].(map[string]any)
+	require.Equal(t, true, schema["strict"])
+	require.Equal(t, "inference_result", schema["name"])
+
+	// no OpenRouter-only routing fields leak into the Runware request
+	require.NotContains(t, body, "session_id")
+	require.NotContains(t, body, "provider")
+}
